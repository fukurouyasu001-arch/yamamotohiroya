# ── 解析エンジン選択 ──────────────────────────────────────────
# keyword: キーワード辞書方式（デフォルト・Ollama 不要・即動作）
# llm:     オンプレ LLM 方式（Ollama セットアップ後に変更）
ANALYZER_ENGINE=keyword

# ── Ollama 接続設定（ANALYZER_ENGINE=llm のときのみ使用）────────
# エンドポイント（デフォルトは localhost。別 PC の場合は IP を変更）
LLM_ENDPOINT=http://localhost:11434

# モデル選択（bash setup_ollama.sh でダウンロード済みのモデル名）
# CPU のみ（PoC・無料検証）: llama3.2:3b  ← デフォルト
# GPU あり・日本語重視:       qwen2.5:7b
# GPU あり・本番精度:         qwen2.5:14b
LLM_MODEL=llama3.2:3b

# タイムスタンプ上限（秒）。CPU 推論は時間がかかるため長め推奨
LLM_TIMEOUT_SECONDS=120

# Ollama 失敗時にキーワード方式へ自動降格するか（推奨: true）
LLM_FALLBACK_TO_KEYWORD=true

# ── データベース ──────────────────────────────────────────────
# 小規模運用: SQLite（追加設定不要）
DATABASE_URL=sqlite:///./matching.db
# 本格運用: PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/matching
