# ── 解析エンジン選択 ──
# keyword: 現状のキーワード辞書方式（デフォルト・オフライン）
# llm:     オンプレLLM方式（Ollama / vLLM 環境構築後に有効化）
ANALYZER_ENGINE=keyword

# ── オンプレLLM接続（analyzer_engine=llm のときに使用）──
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=60

# ── データベース ──
# 小規模運用: SQLite
DATABASE_URL=sqlite:///./matching.db
# 本格運用: PostgreSQL
# DATABASE_URL=postgresql://user:pass@localhost:5432/matching
